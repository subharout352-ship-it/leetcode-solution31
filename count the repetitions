class Solution(object):
    def getMaxRepetitions(self, s1, n1, s2, n2):
        """
        :type s1: str
        :type n1: int
        :type s2: str
        :type n2: int
        :rtype: int
        """
        if n1 == 0:
            return 0

        for ch in set(s2):
            if ch not in s1:
                return 0

        index = 0
        count = 0
        seen = {}

        for i in range(1, n1 + 1):
            for ch in s1:
                if ch == s2[index]:
                    index += 1

                    if index == len(s2):
                        index = 0
                        count += 1

            if index in seen:
                prev_i, prev_count = seen[index]

                cycle_len = i - prev_i
                cycle_count = count - prev_count

                remaining = n1 - i
                cycles = remaining // cycle_len

                count += cycles * cycle_count
                i += cycles * cycle_len

                break
            else:
                seen[index] = (i, count)

        return count // n2
