class Solution(object):
    def validIPAddress(self, queryIP):
        """
        :type queryIP: str
        :rtype: str
        """

        if '.' in queryIP:
            parts = queryIP.split('.')

            if len(parts) != 4:
                return "Neither"

            for part in parts:
                if not part or len(part) > 3:
                    return "Neither"

                if not part.isdigit():
                    return "Neither"

                if len(part) > 1 and part[0] == '0':
                    return "Neither"

                if int(part) > 255:
                    return "Neither"

            return "IPv4"

        elif ':' in queryIP:
            parts = queryIP.split(':')

            if len(parts) != 8:
                return "Neither"

            for part in parts:
                if not part or len(part) > 4:
                    return "Neither"

                for ch in part:
                    if ch not in "0123456789abcdefABCDEF":
                        return "Neither"

            return "IPv6"

        return "Neither"
